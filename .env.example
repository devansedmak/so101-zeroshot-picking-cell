# Copy to .env and fill in. .env is gitignored — NEVER commit it.
# Keep values on their own line with NO trailing comments.

# cyberwave.com/profile -> API Tokens
CYBERWAVE_API_KEY=

# optional, from the dashboard environment page
CYBERWAVE_ENVIRONMENT_ID=

# SO-101 twin UUID: platform -> twin -> "..." -> Python SDK
CYBERWAVE_TWIN_ID=

# optional: override the hosted VLM used by src/perception/detect.py
CYBERWAVE_VLM_MODEL=
